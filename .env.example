# Copie para .env e ajuste. O arquivo .env nunca é versionado nem enviado ao navegador.

# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Banco de desenvolvimento (PostgreSQL 17)
DATABASE_URL=postgres://rotaclara:troque-esta-senha@localhost:5432/rotaclara_dev

# Banco usado apenas pelos testes de integração (opcional; sem ele esses testes são pulados).
# ATENÇÃO: os testes apagam e recriam o schema deste banco. Nunca aponte para o banco de dev.
TEST_DATABASE_URL=postgres://rotaclara:troque-esta-senha@localhost:5432/rotaclara_test

# Fuso operacional (datas de roteiro e recortes)
APP_TIMEZONE=America/Sao_Paulo

# Duração da sessão em minutos (padrão: 720 = 12 h)
SESSAO_DURACAO_MIN=720

# Cookie Secure: "true" em produção (HTTPS). Padrão: true quando NODE_ENV=production.
COOKIE_SECURE=false

# Origens extras aceitas em requisições que alteram estado (separadas por vírgula).
# A própria origem do servidor é sempre aceita. Ex.: https://rotaclara.exemplo
APP_ORIGENS=

