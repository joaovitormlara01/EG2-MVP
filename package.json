{
  "name": "rotaclara",
  "version": "0.1.0",
  "private": true,
  "description": "RotaClara — registro de paradas, histórico, dashboard e custo de roteiros de entrega.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/server.js",
    "dev": "node --env-file-if-exists=.env --watch-path=src --watch-path=public src/server/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/server/db/cli/migrar.js",
    "db:criar-admin": "node --env-file-if-exists=.env src/server/db/cli/criar-admin.js",
    "lint": "eslint .",
    "check": "node scripts/verificar-sintaxe.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verificar": "npm run check && npm run lint && npm test",
    "dados:demo": "node --env-file-if-exists=.env scripts/gerar-dados-sinteticos.js --modo demo",
    "dados:desempenho": "node --env-file-if-exists=.env scripts/gerar-dados-sinteticos.js --modo desempenho",
    "medir:api": "node --env-file-if-exists=.env scripts/medir-desempenho.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "chart.js": "^4.5.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "vitest": "^5.0.2"
  }
}
